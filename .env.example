# Copy to .env.local and fill in. These are server-side only on purpose —
# no NEXT_PUBLIC_ prefix, so the Supabase key never reaches the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# The app's own login.
AUTH_PASSWORD=pick-something-long
# Generate with: openssl rand -base64 32
AUTH_SECRET=paste-a-long-random-string-here
